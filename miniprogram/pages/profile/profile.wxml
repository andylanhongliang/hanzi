<view class="profile-page {{eyeProtect ? 'eye-protect' : ''}}">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{learnedCount}}</text>
      <text class="stat-label">已认识</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{starCount}}</text>
      <text class="stat-label">星星</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{todayCount}}</text>
      <text class="stat-label">今日已学</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{streakDays}}天</text>
      <text class="stat-label">连续学习</text>
    </view>
  </view>

  <!-- 近期认识 -->
  <view class="section">
    <view class="section-title">最近认识的字</view>
    <view class="tag-wrap">
      <text wx:for="{{recentChars}}" wx:key="*this" class="tag-item">{{item}}</text>
      <text wx:if="{{recentChars.length === 0}}" class="empty-text">开始探索吧！</text>
    </view>
  </view>

  <!-- 错字本 -->
  <view class="section">
    <view class="section-title">错字本</view>
    <view class="tag-wrap">
      <text wx:for="{{mistakeChars}}" wx:key="*this" class="tag-item mistake-tag">{{item}}</text>
      <text wx:if="{{mistakeChars.length === 0}}" class="empty-text">暂无错字 👍</text>
    </view>
    <button wx:if="{{mistakeChars.length > 0}}" class="btn btn-primary" bindtap="startReview">📝 复习错字</button>
  </view>

  <!-- 宠物 -->
  <view class="section">
    <view class="section-title">小宠物</view>
    <view class="pet-card">
      <text class="pet-avatar">{{petEmoji}}</text>
      <view class="pet-info">
        <text class="pet-name">{{petName}} Lv{{petLevel}}</text>
        <view class="pet-exp-bar">
          <view class="pet-exp-fill" style="width: {{petExpPct}}%"></view>
        </view>
        <text class="pet-exp-text">{{petExp}}/{{petExpNext}}</text>
      </view>
    </view>
  </view>

  <!-- 成就 -->
  <view class="section">
    <view class="section-title">我的成就</view>
    <view class="badge-list">
      <text wx:for="{{badges}}" wx:key="*this" class="badge-item">{{item}}</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="section">
    <view class="section-title">设置</view>
    <view class="setting-row" bindtap="toggleEye">
      <text>护眼模式</text>
      <text class="switch {{eyeProtect ? 'on' : ''}}">{{eyeProtect ? '🌙' : '☀️'}}</text>
    </view>
    <view class="setting-row" bindtap="toggleSound">
      <text>音效</text>
      <text class="switch {{soundEnabled ? 'on' : ''}}">{{soundEnabled ? '🔊' : '🔇'}}</text>
    </view>
  </view>

  <!-- 用户切换 -->
  <view class="section">
    <view class="section-title">用户</view>
    <view class="user-list">
      <view 
        wx:for="{{users}}" 
        wx:key="*this"
        class="user-item {{item === currentUser ? 'active' : ''}}"
        data-name="{{item}}"
        bindtap="switchToUser"
      >{{item}}</view>
    </view>
    <view class="add-user">
      <input class="user-input" placeholder="输入新用户名" value="{{newUserName}}" bindinput="onUserNameInput" />
      <button class="btn btn-primary" bindtap="createUser">创建</button>
    </view>
  </view>

  <button class="btn btn-secondary back-btn" bindtap="goBack">返回图谱</button>
</view>
