/* 主页样式 */

.page-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-main);
  transition: var(--transition);
}

/* 顶部导航 */
.header {
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  background: var(--bg-float);
  border-bottom: 2px solid var(--color-border);
  flex-shrink: 0;
}
.logo {
  font-size: 20px;
  color: var(--color-primary);
  font-weight: bold;
  letter-spacing: 2px;
}
.header-right {
  display: flex;
  gap: 8px;
}
.icon-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid var(--color-border);
  background: transparent;
  font-size: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}
.icon-btn:active {
  background: var(--color-primary);
  color: #fff;
}

/* 图表区域 */
.chart-container {
  flex: 1;
  height: 0;
  position: relative;
  overflow: hidden;
}

/* 工具栏 */
.float-tool {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 10;
}
.progress-ring {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--bg-float);
  border: 3px solid var(--color-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.progress-text {
  font-size: 10px;
  font-weight: bold;
  color: var(--color-secondary);
  text-align: center;
  line-height: 1.2;
}
.daily-task {
  font-size: 10px;
  color: var(--text-secondary);
  text-align: center;
  background: var(--bg-float);
  padding: 4px 6px;
  border-radius: 8px;
  border: 1px solid var(--color-border);
}
.tool-btn {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--bg-float);
  border: 2px solid var(--color-border);
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.tool-btn:active {
  background: var(--color-primary);
  color: #fff;
}

/* 详情面板 */
.aside-panel {
  position: absolute;
  right: 0;
  top: 0;
  width: 280px;
  height: 100%;
  background: var(--bg-float);
  border-left: 2px solid var(--color-border);
  z-index: 10;
  padding: 16px;
  overflow-y: auto;
  transition: transform 0.3s ease;
}
.aside-panel.hide {
  transform: translateX(100%);
}
.panel-char {
  text-align: center;
  font-size: 56px;
  color: var(--color-primary);
  text-shadow: 0 0 10px rgba(74,144,226,0.2);
}
.panel-pinyin {
  text-align: center;
  font-size: 16px;
  color: var(--color-secondary);
  margin-bottom: 4px;
}
.panel-trad {
  text-align: center;
  font-size: 22px;
  color: #8b4513;
  margin-bottom: 8px;
}
.panel-label {
  color: var(--color-primary);
  font-weight: bold;
  margin: 12px 0 4px;
  font-size: 14px;
}
.panel-text {
  color: var(--text-primary);
  line-height: 1.5;
  font-size: 13px;
}
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.tag-item {
  background: rgba(74,144,226,0.15);
  color: var(--color-primary);
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 13px;
}
.related-tag:active {
  background: var(--color-primary);
  color: #fff;
}

/* 里程碑 */
.milestone-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  background: var(--bg-panel);
  border-radius: 20px;
  padding: 24px 32px;
  text-align: center;
  box-shadow: var(--shadow-normal);
  z-index: 100;
  transition: transform 0.3s ease;
}
.milestone-toast.show {
  transform: translate(-50%, -50%) scale(1);
}
.milestone-badge {
  font-size: 48px;
}
.milestone-title {
  font-size: 20px;
  font-weight: bold;
  color: var(--color-primary);
  margin-top: 8px;
}
