.guess-page {
  min-height: 100vh;
  padding: 20px;
  background: var(--bg-main);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guess-header {
  text-align: center;
  margin-bottom: 24px;
}
.guess-title {
  font-size: 26px;
  color: var(--color-primary);
  font-weight: bold;
  display: block;
}
.guess-info {
  font-size: 14px;
  color: var(--text-secondary);
  margin-top: 4px;
}

/* 提示区 */
.hint-section {
  width: 100%;
  max-width: 380px;
  background: var(--bg-panel);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: var(--shadow-normal);
}
.hint-label {
  font-size: 16px;
  color: var(--color-secondary);
  margin-bottom: 10px;
}
.hint-text {
  font-size: 20px;
  color: var(--text-primary);
  line-height: 1.6;
}
.hint-extra {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--color-border);
}
.hint-item {
  font-size: 15px;
  color: var(--text-secondary);
}

/* 候选按钮 */
.candidates {
  width: 100%;
  max-width: 380px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 16px;
}
.candidate-btn {
  height: 72px;
  font-size: 32px;
  border-radius: 16px;
  border: 3px solid var(--color-border);
  background: var(--bg-panel);
  color: var(--text-primary);
  font-family: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}
.candidate-btn:active {
  transform: scale(0.95);
}
.candidate-btn.selected {
  border-color: var(--color-primary);
  background: rgba(74,144,226,0.15);
}
.candidate-btn.correct {
  border-color: var(--color-success);
  background: rgba(82,196,26,0.2);
  color: var(--color-success);
}
.candidate-btn.wrong {
  border-color: var(--color-error);
  background: rgba(255,77,79,0.15);
  color: var(--color-error);
}

/* 输入区 */
.input-section {
  width: 100%;
  max-width: 380px;
  margin-bottom: 16px;
}
.guess-input {
  width: 100%;
  height: 48px;
  padding: 0 16px;
  border-radius: 12px;
  border: 2px solid var(--color-border);
  background: var(--bg-panel);
  font-size: 18px;
  color: var(--text-primary);
  font-family: inherit;
  text-align: center;
}

/* 结果区 */
.result-section {
  width: 100%;
  max-width: 380px;
  margin: 16px 0;
  text-align: center;
}
.result-icon {
  font-size: 48px;
  display: block;
}
.result-text {
  font-size: 18px;
  margin-top: 8px;
  display: block;
}
.result-correct .result-text {
  color: var(--color-success);
}
.result-wrong .result-text {
  color: var(--color-error);
}

/* 按钮 */
.action-buttons {
  width: 100%;
  max-width: 380px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 8px;
}
.btn {
  width: 100%;
  padding: 14px 0;
  border-radius: 14px;
  border: none;
  font-size: 17px;
  font-family: inherit;
}
.btn-primary {
  background: var(--color-primary);
  color: #fff;
}
.btn-secondary {
  background: transparent;
  color: var(--color-primary);
  border: 2px solid var(--color-border);
}
.btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}
